<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Supermarket Rubik</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniMarketApp.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    @{
        bool esAdmin = User.IsInRole("Admin") || (User.Identity?.IsAuthenticated == true && User.Identity.Name == "admin@marketrubik.com");
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark shadow-sm mb-3 py-2">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white fs-4" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="Supermarket Rubik Logo" style="height: 38px; width: 38px; object-fit: contain;" class="rounded-circle bg-white p-1" />
                    <span>Supermarket Rubik</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-flex-wrap navbar-nav flex-grow-1 ms-3">
                    @if (User.IsInRole("Cliente") && !User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link text-white opacity-75 custom-hover" href="/Chat"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i> Mensajes</a></li>
                    }
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-75 custom-hover" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i> Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-75 custom-hover" asp-area="" asp-controller="Tienda" asp-action="Index"><i class="bi bi-shop me-1"></i> Tienda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-75 custom-hover" asp-area="" asp-controller="Categorias" asp-action="Index"><i class="bi bi-tags me-1"></i> Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white opacity-75 custom-hover" asp-area="" asp-controller="Sucursales" asp-action="Index"><i class="bi bi-building me-1"></i> Sucursales</a>
                        </li>

                        @if (!esAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white opacity-75 custom-hover" asp-area="" asp-controller="AI" asp-action="ChatbotCliente"><i class="bi bi-magic me-1"></i> Recetas e IA</a>
                            </li>
                        }

                        @if (esAdmin)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock-fill me-1 text-warning"></i> Administración
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 rounded-3" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item py-2" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-gear me-2 text-warning fw-bold"></i> Gestión de Usuarios</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Productos" asp-action="Index"><i class="bi bi-box-seam me-2 text-primary"></i> Gestión Productos</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Categorias" asp-action="Index"><i class="bi bi-tags me-2 text-info"></i> Gestión Categorías</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Proveedores" asp-action="Index"><i class="bi bi-truck me-2 text-success"></i> Proveedores</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i> Clientes</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Empleados" asp-action="Index"><i class="bi bi-person-badge me-2 text-secondary"></i> Empleados</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Sucursales" asp-action="Index"><i class="bi bi-building me-2 text-dark"></i> Sucursales</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Ventas" asp-action="Index"><i class="bi bi-receipt me-2 text-success"></i> Historial de Ventas</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Promociones" asp-action="Index"><i class="bi bi-tags-fill me-2 text-warning"></i> Gestión Promociones</a></li>
                                    <li><a class="dropdown-item py-2" asp-controller="Reportes" asp-action="Index"><i class="bi bi-bar-chart-line me-2 text-danger"></i> Reportes y Métricas</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white opacity-75 custom-hover fw-bold text-warning" asp-area="" asp-controller="AI" asp-action="Index"><i class="bi bi-cpu-fill me-1"></i> IA Demanda</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container-body-wrapper">
        <div class="container mt-3">
            @{
                var errorMsg = TempData["Error"] as string;
                if (errorMsg != null)
                {
                    TempData.Remove("Error");
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center justify-content-between p-3" role="alert" style="background-color: #fee2e2; color: #dc2626;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <strong class="fw-semibold">@errorMsg</strong>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(15%) sepia(95%) saturate(6932%) hue-rotate(354deg) brightness(89%) contrast(92%);"></button>
                    </div>
                }

                var errorMsg2 = TempData["ErrorMessage"] as string;
                if (errorMsg2 != null)
                {
                    TempData.Remove("ErrorMessage");
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center justify-content-between p-3" role="alert" style="background-color: #fee2e2; color: #dc2626;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <strong class="fw-semibold">@errorMsg2</strong>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(15%) sepia(95%) saturate(6932%) hue-rotate(354deg) brightness(89%) contrast(92%);"></button>
                    </div>
                }

                var successMsg = TempData["SuccessMessage"] as string;
                if (successMsg != null)
                {
                    TempData.Remove("SuccessMessage");
                    <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 d-flex align-items-center justify-content-between p-3" role="alert" style="background-color: #dcfce7; color: #16a34a;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill fs-5"></i>
                            <strong class="fw-semibold">@successMsg</strong>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(34%) sepia(82%) saturate(452%) hue-rotate(94deg) brightness(95%) contrast(89%);"></button>
                    </div>
                }

                var alertMsg = TempData["MensajeAlerta"] as string;
                if (alertMsg != null)
                {
                    TempData.Remove("MensajeAlerta");
                    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 d-flex align-items-center justify-content-between p-3" role="alert" style="background-color: #fee2e2; color: #dc2626;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                            <strong class="fw-semibold">@alertMsg</strong>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="filter: invert(15%) sepia(95%) saturate(6932%) hue-rotate(354deg) brightness(89%) contrast(92%);"></button>
                    </div>
                }
            }
        </div>
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white mt-auto py-3">
        <div class="container text-center">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <img src="~/images/logo.png" alt="Supermarket Rubik Logo" style="height: 24px; width: 24px; object-fit: contain;" />
                <span class="fw-bold text-dark">&copy; 2026 - Supermarket Rubik</span>
            </div>
            <small class="text-muted">Evaluación Tercer Parcial • Plataforma Web con IA Ollama (qwen2.5:1.5b)</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.IsInRole("Admin") || User.IsInRole("Cliente"))
    {
        <div id="live-notice" data-admin="@(User.IsInRole("Admin") ? "true" : "false")" class="position-fixed bottom-0 start-50 translate-middle-x bg-white shadow rounded px-3 text-center" style="z-index:1080" role="status"></div>
        <script src="~/lib/signalr/signalr.min.js"></script>
        <script src="~/js/market-live.js"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
    <!-- jQuery must be loaded BEFORE the Scripts section for $.post to work -->
</body>
</html>
