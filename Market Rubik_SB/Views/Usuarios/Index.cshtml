@model IEnumerable<MiniMarketApp.Controllers.UsuarioViewModel>
@{
    ViewData["Title"] = "Gestión de Usuarios del Sistema";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 text-primary fw-bold mb-1">
                <i class="bi bi-person-gear me-2"></i>Gestión de Usuarios
            </h1>
            <p class="text-muted mb-0">Administra las cuentas de usuario, asignación de roles y estados de activación en Supermarket Rubik.</p>
        </div>
        <div>
            <a asp-action="Crear" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Crear Nuevo Usuario
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 border-bottom border-light">
            <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-people-fill me-2 text-primary"></i> Listado General de Usuarios</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Correo / Usuario</th>
                            <th>Rol Actual</th>
                            <th>Estado</th>
                            <th class="text-center">Cambiar Rol</th>
                            <th class="text-end pe-4">Acción (Eliminación Lógica)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    <i class="bi bi-person-circle me-2 text-secondary"></i> @user.Email
                                </td>
                                <td>
                                    @if (user.Rol == "Admin")
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="bi bi-shield-lock-fill me-1"></i> Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary px-3 py-2 rounded-pill"><i class="bi bi-person-fill me-1"></i> Cliente</span>
                                    }
                                </td>
                                <td>
                                    @if (user.Activo)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-check-circle-fill me-1"></i> Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill fw-semibold">
                                            <i class="bi bi-slash-circle-fill me-1"></i> Desactivado
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <form asp-action="CambiarRol" method="post" class="d-inline-flex gap-2 align-items-center">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <select name="nuevoRol" class="form-select form-select-sm rounded-pill" style="width: 120px;" onchange="this.form.submit()">
                                            <option value="Cliente" selected="@(user.Rol == "Cliente")">Cliente</option>
                                            <option value="Admin" selected="@(user.Rol == "Admin")">Admin</option>
                                        </select>
                                    </form>
                                </td>
                                <td class="text-end pe-4">
                                    @if (user.Email != "admin@marketrubik.com")
                                    {
                                        <form asp-action="ToggleEstado" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.Activo)
                                            {
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('¿Desactivar lógicamente este usuario?')">
                                                    <i class="bi bi-power me-1"></i> Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                                    <i class="bi bi-check2-circle me-1"></i> Activar
                                                </button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <small class="text-muted fst-italic">Cuenta Principal Protegida</small>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
