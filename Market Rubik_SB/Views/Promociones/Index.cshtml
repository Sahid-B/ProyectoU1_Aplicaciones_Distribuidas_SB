@model IEnumerable<MiniMarketApp.Models.Promocion>

@{
    ViewData["Title"] = "Promociones";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-tag text-primary"></i> Ofertas y Promociones</h2>
        <a asp-action="Create" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>Nueva Promoción
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Nombre</th>
                            <th>Tipo</th>
                            <th>Descuento</th>
                            <th>Validez</th>
                            <th>Filtro</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model) {
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">
                                    @Html.DisplayFor(modelItem => item.Nombre)
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.TipoDescuento</span>
                                </td>
                                <td>
                                    @if(item.TipoDescuento == "Porcentaje") {
                                        <span class="text-success fw-bold">@item.ValorDescuento.ToString("0")%</span>
                                    } else {
                                        <span class="text-success fw-bold">$@item.ValorDescuento.ToString("0.00")</span>
                                    }
                                </td>
                                <td>
                                    <small class="text-muted d-block">Del: @item.FechaInicio.ToString("dd/MM/yyyy")</small>
                                    <small class="text-muted d-block">Al: @item.FechaFin.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @if(item.Categoria != null) {
                                        <span class="badge bg-info text-dark">Cat: @item.Categoria.Nombre</span>
                                    }
                                    @if(item.Producto != null) {
                                        <span class="badge bg-info text-dark">Prod: @item.Producto.Nombre</span>
                                    }
                                    @if(item.Categoria == null && item.Producto == null) {
                                        <span class="badge bg-light text-dark border">Toda la tienda</span>
                                    }
                                </td>
                                <td>
                                    @if(item.Activo && item.FechaFin >= DateTime.UtcNow && item.FechaInicio <= DateTime.UtcNow) {
                                        <span class="badge bg-success rounded-pill"><i class="bi bi-check-circle me-1"></i>Activa</span>
                                    } else if (!item.Activo) {
                                        <span class="badge bg-danger rounded-pill">Inactiva</span>
                                    } else {
                                        <span class="badge bg-warning text-dark rounded-pill">Programada/Expirada</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
