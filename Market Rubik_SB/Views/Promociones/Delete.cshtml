@model MiniMarketApp.Models.Promocion

@{
    ViewData["Title"] = "Eliminar Promoción";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 border-danger">
                <div class="card-header bg-danger text-white border-bottom-0 pt-4 pb-3 px-4 rounded-top-4">
                    <h3 class="fw-bold mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i> Eliminar Promoción</h3>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title text-danger mb-4">¿Estás seguro de que deseas desactivar esta promoción?</h5>
                    
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Nombre</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Descuento</dt>
                        <dd class="col-sm-8">@Model.ValorDescuento @(Model.TipoDescuento == "Porcentaje" ? "%" : "$")</dd>

                        <dt class="col-sm-4 text-muted">Válida Desde</dt>
                        <dd class="col-sm-8">@Model.FechaInicio.ToString("g")</dd>

                        <dt class="col-sm-4 text-muted">Válida Hasta</dt>
                        <dd class="col-sm-8">@Model.FechaFin.ToString("g")</dd>

                        <dt class="col-sm-4 text-muted">Categoría</dt>
                        <dd class="col-sm-8">@(Model.Categoria?.Nombre ?? "Toda la tienda")</dd>
                    </dl>

                    <form asp-action="Delete" class="mt-4">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold">Sí, Eliminar</button>
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
