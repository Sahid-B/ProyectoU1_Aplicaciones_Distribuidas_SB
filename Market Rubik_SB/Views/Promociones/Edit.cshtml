@model MiniMarketApp.Models.Promocion

@{
    ViewData["Title"] = "Editar Promoción";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                    <h3 class="fw-bold mb-0 text-primary">Editar Promoción</h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row g-3 mb-3">
                            <div class="col-md-12">
                                <label asp-for="Nombre" class="form-label fw-semibold">Nombre de la Oferta</label>
                                <input asp-for="Nombre" class="form-control rounded-3" />
                                <span asp-validation-for="Nombre" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="TipoDescuento" class="form-label fw-semibold">Tipo de Descuento</label>
                                <select asp-for="TipoDescuento" class="form-select rounded-3">
                                    <option value="Porcentaje">Porcentaje (%)</option>
                                    <option value="MontoFijo">Monto Fijo ($)</option>
                                </select>
                                <span asp-validation-for="TipoDescuento" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="ValorDescuento" class="form-label fw-semibold">Valor</label>
                                <input asp-for="ValorDescuento" class="form-control rounded-3" type="number" step="0.01" />
                                <span asp-validation-for="ValorDescuento" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="FechaInicio" class="form-label fw-semibold">Válida Desde</label>
                                <input asp-for="FechaInicio" class="form-control rounded-3" type="datetime-local" />
                                <span asp-validation-for="FechaInicio" class="text-danger"></span>
                            </div>
                            
                            <div class="col-md-6">
                                <label asp-for="FechaFin" class="form-label fw-semibold">Válida Hasta</label>
                                <input asp-for="FechaFin" class="form-control rounded-3" type="datetime-local" />
                                <span asp-validation-for="FechaFin" class="text-danger"></span>
                            </div>

                            <hr class="my-4" />
                            <h5 class="fw-bold mb-3 text-secondary">Condiciones (Opcional)</h5>

                            <div class="col-md-6">
                                <label asp-for="CategoriaId" class="form-label fw-semibold">Aplica a Categoría</label>
                                <select asp-for="CategoriaId" class="form-select rounded-3" asp-items="ViewBag.CategoriaId">
                                    <option value="">-- Toda la tienda --</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ProductoId" class="form-label fw-semibold">O a un Producto Específico</label>
                                <select asp-for="ProductoId" class="form-select rounded-3" asp-items="ViewBag.ProductoId">
                                    <option value="">-- Cualquiera --</option>
                                </select>
                            </div>

                            <div class="col-md-12">
                                <label asp-for="CantidadMinima" class="form-label fw-semibold">Cantidad Mínima Requerida en el Carrito</label>
                                <input asp-for="CantidadMinima" class="form-control rounded-3" type="number" />
                                <span asp-validation-for="CantidadMinima" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-4 mt-3">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="Activo">
                            <label class="form-check-label ms-2" asp-for="Activo">Activar promoción</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">Guardar Cambios</button>
                            <a asp-action="Index" class="btn btn-light rounded-pill px-4">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#ProductoId').select2({
                theme: 'bootstrap-5',
                placeholder: '-- Buscar un producto --',
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
