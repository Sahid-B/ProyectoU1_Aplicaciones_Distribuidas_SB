@model IEnumerable<MiniMarketApp.ViewModels.PagosPorPasarelaDto>
@{
    ViewData["Title"] = "Pagos por Pasarela";
}

<div class="container mt-4">
    <h2>Reporte de Pagos por Pasarela</h2>
    
        <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label class="form-label">Fecha Desde</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha Hasta</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel"></i> Filtrar</button>
            <a href="?fechaInicio=&fechaFin=" class="btn btn-secondary ms-2 w-100"><i class="bi bi-eraser"></i> Limpiar</a>
        </div>
    </form>
<div id="reporte-pdf">
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Pasarela</th>
                    <th>Cantidad de Pagos</th>
                    <th>Total Recaudado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Pasarela</td>
                        <td>@item.CantidadPagos</td>
                        <td>@item.TotalRecaudado.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
        <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver a Reportes</a>
    </div>
</div>


