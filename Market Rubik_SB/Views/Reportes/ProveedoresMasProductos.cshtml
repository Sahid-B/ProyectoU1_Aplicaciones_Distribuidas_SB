@model IEnumerable<MiniMarketApp.ViewModels.ProveedorMasProductosDto>
@{
    ViewData["Title"] = "Proveedores con Más Productos";
}

<div class="container mt-4">
    <h2>Top 10 Proveedores con Más Productos</h2><div id="reporte-pdf">
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Proveedor</th>
                <th>Cantidad de Productos</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Proveedor</td>
                    <td>@item.CantidadProductos</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver a Reportes</a>
</div>


</div>
</div>

