@model IEnumerable<MiniMarketApp.ViewModels.ProductoStockDto>
@{
    ViewData["Title"] = "Productos Bajo Stock";
    int paginaActual = ViewBag.Pagina;
}

<div class="container mt-4">
    <h2>Productos con Bajo Stock</h2><div id="reporte-pdf">
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Producto</th>
                <th>Stock Disponible</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td><span class="badge bg-danger">@item.Stock</span></td>
                </tr>
            }
        </tbody>
    </table>
    
    <div class="d-flex justify-content-between mt-3">
        @if (paginaActual > 1)
        {
            <a asp-action="ProductosBajoStock" asp-route-pagina="@(paginaActual - 1)" class="btn btn-outline-primary">Anterior</a>
        }
        else
        {
            <span></span>
        }
        <a asp-action="ProductosBajoStock" asp-route-pagina="@(paginaActual + 1)" class="btn btn-outline-primary">Siguiente</a>
    </div>

    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver a Reportes</a>
</div>


</div>
</div>

