@model IEnumerable<MiniMarketApp.ViewModels.VentasPorMesDto>
@{
    ViewData["Title"] = "Ventas por Mes";
}

<div class="container mt-4">
    <h2>Ventas por Mes</h2><div id="reporte-pdf">
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Año</th>
                <th>Mes</th>
                <th>Cantidad de Ventas</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Anio</td>
                    <td>@item.Mes</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver a Reportes</a>
</div>


</div>
</div>

