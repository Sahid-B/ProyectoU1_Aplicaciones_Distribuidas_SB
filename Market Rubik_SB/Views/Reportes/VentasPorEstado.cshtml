@model IEnumerable<MiniMarketApp.ViewModels.VentasPorEstadoDto>
@{
    ViewData["Title"] = "Ventas por Estado";
}

<div class="container mt-4">
    <h2>Ventas por Estado</h2>    <form method="get" class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label">Fecha Desde</label>
            <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Fecha Hasta</label>
            <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select name="estado" class="form-select">
                <option value="">Todos</option>
                <option value="Completada" selected="@(ViewBag.Estado == "Completada" ? "selected" : null)">Completada</option>
                <option value="Pendiente" selected="@(ViewBag.Estado == "Pendiente" ? "selected" : null)">Pendiente</option>
                <option value="Cancelada" selected="@(ViewBag.Estado == "Cancelada" ? "selected" : null)">Cancelada</option>
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-50"><i class="bi bi-funnel"></i></button>
            <a href="?fechaInicio=&fechaFin=&estado=" class="btn btn-secondary w-50 ms-1"><i class="bi bi-eraser"></i></a>
        </div>
    </form>
<div id="reporte-pdf">
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Estado</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Estado</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Total.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
    <a asp-action="Index" class="btn btn-secondary mt-3"><i class="bi bi-arrow-left"></i> Volver a Reportes</a>
</div>


</div>
</div>

