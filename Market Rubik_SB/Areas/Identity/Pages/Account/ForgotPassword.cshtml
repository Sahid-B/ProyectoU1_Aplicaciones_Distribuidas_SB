@page
@model MiniMarketApp.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña - Supermarket Rubik";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden auth-card">
            <div class="card-header text-white text-center py-4 px-4 position-relative" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="security-badge-wrapper mb-2">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm p-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-key-fill text-primary fs-2"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">Recuperar Contraseña</h3>
                <p class="mb-0 text-white-50 fs-6">Supermarket Rubik</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <p class="text-muted small mb-4">Ingresa la dirección de correo registrada en tu cuenta para recibir las instrucciones de restablecimiento.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 shadow-sm" role="alert"></div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope-fill me-1 text-primary"></i> Correo Electrónico</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-primary bg-gradient btn-lg rounded-3 fw-bold shadow-sm py-3 mb-3 border-0 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-send-fill fs-6"></i> Enviar enlace de recuperación
                    </button>
                </form>

                <div class="text-center mt-3">
                    <a asp-page="./Login" class="text-decoration-none small text-muted">
                        <i class="bi bi-arrow-left me-1"></i> Volver al Inicio de Sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
