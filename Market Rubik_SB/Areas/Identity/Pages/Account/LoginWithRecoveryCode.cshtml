@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Internal.LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Código de Recuperación - Supermarket Rubik";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden auth-card">
            <div class="card-header text-white text-center py-4 px-4 position-relative" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <div class="security-badge-wrapper mb-2">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm p-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-key-fill text-warning fs-2"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">Código de Recuperación</h3>
                <p class="mb-0 text-white-50 fs-6">Acceso de Emergencia (2FA)</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <div class="alert alert-warning border-0 rounded-3 d-flex align-items-start gap-2 mb-4 p-3 shadow-sm">
                    <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0 mt-1"></i>
                    <small>Estás iniciando sesión con un código de recuperación de emergencia. Cada código solo puede ser utilizado una sola vez.</small>
                </div>

                <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 shadow-sm" role="alert"></div>

                    <div class="mb-4">
                        <label asp-for="Input.RecoveryCode" class="form-label fw-semibold text-secondary mb-2">
                            <i class="bi bi-shield-lock me-1 text-primary"></i> Ingresa tu código de recuperación
                        </label>
                        <div class="input-group input-group-lg shadow-sm rounded-3 overflow-hidden">
                            <span class="input-group-text bg-light border-end-0 text-muted px-3">
                                <i class="bi bi-ticket-perforated-fill text-warning"></i>
                            </span>
                            <input asp-for="Input.RecoveryCode" 
                                   class="form-control border-start-0 font-monospace fs-4 text-center" 
                                   autocomplete="off" 
                                   placeholder="XXXXX-XXXXX" 
                                   autofocus />
                        </div>
                        <span asp-validation-for="Input.RecoveryCode" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-primary bg-gradient btn-lg rounded-3 fw-bold shadow-sm py-3 mb-3 border-0 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-box-arrow-in-right fs-5"></i> Acceder a la Cuenta
                    </button>
                </form>

                <hr class="my-4 text-muted opacity-25" />

                <div class="text-center">
                    <a asp-page="./LoginWith2fa" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none small text-primary fw-semibold">
                        <i class="bi bi-phone me-1"></i> Volver a ingresar código de app autenticadora
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
