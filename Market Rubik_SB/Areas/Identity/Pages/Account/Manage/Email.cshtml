@page
@model EmailModel
@{
    ViewData["Title"] = "Gestión de Correo Electrónico";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<div class="row">
    <div class="col-md-10 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-3 text-primary">
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="bi bi-envelope-at fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Gestión de Correo Electrónico</h3>
                <p class="text-muted small mb-0">Actualiza tu dirección de correo electrónico vinculada a la cuenta.</p>
            </div>
        </div>
        <hr class="my-4 text-muted opacity-25" />

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="email-form" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3 input-group">
                <input asp-for="Email" class="form-control bg-light" placeholder="Correo Actual" disabled />
                <label asp-for="Email" class="form-label">Correo Electrónico Actual</label>
                @if (Model.IsEmailConfirmed)
                {
                    <span class="input-group-text bg-success bg-opacity-10 text-success border-start-0 fw-semibold px-3 d-flex align-items-center gap-1">
                        <i class="bi bi-check-circle-fill"></i> Verificado
                    </span>
                }
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.NewEmail" class="form-control border-primary border-opacity-25" placeholder="Ingresa tu nuevo correo" />
                <label asp-for="Input.NewEmail" class="form-label">Nuevo Correo Electrónico</label>
                <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
            </div>

            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-envelope-paper-fill me-1"></i> Cambiar Correo Electrónico
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
