@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row">
    <div class="col-md-10 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-3 text-primary">
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="bi bi-key-fill fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Cambiar Contraseña</h3>
                <p class="text-muted small mb-0">Actualiza tu clave de acceso por motivos de seguridad.</p>
            </div>
        </div>
        <hr class="my-4 text-muted opacity-25" />

        <partial name="_StatusMessage" for="StatusMessage" />

        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.OldPassword" class="form-control border-primary border-opacity-25" autocomplete="current-password" placeholder="Ingresa tu contraseña actual" />
                <label asp-for="Input.OldPassword" class="form-label">Contraseña Actual</label>
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword" class="form-control border-primary border-opacity-25" autocomplete="new-password" placeholder="Ingresa tu nueva contraseña" />
                <label asp-for="Input.NewPassword" class="form-label">Nueva Contraseña</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control border-primary border-opacity-25" autocomplete="new-password" placeholder="Confirma tu nueva contraseña" />
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar Nueva Contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-shield-check me-1"></i> Actualizar Contraseña
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
