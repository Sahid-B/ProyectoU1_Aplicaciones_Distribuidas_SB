@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<div class="list-group shadow-sm border-0 rounded-4 overflow-hidden mb-4">
    <a class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.IndexNavClass(ViewContext)" id="profile" asp-page="./Index">
        <i class="bi bi-person-badge fs-5"></i> Perfil
    </a>
    <a class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.EmailNavClass(ViewContext)" id="email" asp-page="./Email">
        <i class="bi bi-envelope-at fs-5"></i> Correo Electrónico
    </a>
    <a class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.ChangePasswordNavClass(ViewContext)" id="change-password" asp-page="./ChangePassword">
        <i class="bi bi-key-fill fs-5"></i> Contraseña
    </a>
    @if (hasExternalLogins)
    {
        <a id="external-login" class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins">
            <i class="bi bi-shield-lock fs-5"></i> Cuentas Externas (Google)
        </a>
    }
    <a class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" id="two-factor" asp-page="./TwoFactorAuthentication">
        <i class="bi bi-phone-vibrate fs-5"></i> Autenticación 2FA / TOTP
    </a>
    <a class="list-group-item list-group-item-action py-3 px-4 fw-semibold border-0 d-flex align-items-center gap-2 @ManageNavPages.PersonalDataNavClass(ViewContext)" id="personal-data" asp-page="./PersonalData">
        <i class="bi bi-database-lock fs-5"></i> Datos Personales
    </a>
</div>
