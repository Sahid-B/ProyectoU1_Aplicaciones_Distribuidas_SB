@page
@model Microsoft.AspNetCore.Identity.UI.V5.Pages.Account.Manage.Internal.EnableAuthenticatorModel

@{
    ViewData["Title"] = "Configurar Aplicación Autenticadora (TOTP / MFA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<h3 class="fw-bold text-primary mb-3"><i class="bi bi-shield-check me-2"></i>@ViewData["Title"]</h3>
<p class="text-muted">Sigue los siguientes pasos para vincular tu aplicación autenticadora (Google Authenticator, Microsoft Authenticator o Authy):</p>

<div class="row g-4 my-2">
    <div class="col-md-7">
        <ol class="list-group list-group-numbered border-0 shadow-sm rounded-3 mb-4">
            <li class="list-group-item d-flex justify-content-between align-items-start border-0 py-3">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">Descarga una app autenticadora</div>
                    Descarga Google Authenticator o Microsoft Authenticator en tu dispositivo móvil.
                </div>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-start border-0 py-3">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">Escanea el código QR o ingresa la clave</div>
                    Escanea la imagen QR generada o ingresa la clave de configuración manual:
                    <div class="alert alert-secondary text-monospace text-break fw-bold my-2 p-2 fs-6">
                        @Model.SharedKey
                    </div>
                </div>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-start border-0 py-3">
                <div class="ms-2 me-auto">
                    <div class="fw-bold">Verifica el código generado</div>
                    Ingresa el código de 6 dígitos que muestra tu app móvil para finalizar la activación.
                </div>
            </li>
        </ol>

        <form id="send-code" method="post">
            <div class="form-floating mb-3">
                <input asp-for="Input.Code" class="form-control rounded-3 fs-5 text-center fw-bold" autocomplete="off" placeholder="123456" />
                <label asp-for="Input.Code" class="text-muted">Código de verificación (6 dígitos)</label>
                <span asp-validation-for="Input.Code" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-bold px-4 shadow-sm" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%); border: none;">
                <i class="bi bi-check-circle-fill me-1"></i> Verificar y Activar MFA
            </button>
        </form>
    </div>

    <div class="col-md-5 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-light h-100 d-flex flex-column align-items-center justify-content-center">
            <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-qr-code-scan me-1"></i> Código QR TOTP</h6>
            <div id="qrCode" class="p-3 bg-white rounded-3 shadow-sm mb-3"></div>
            <small class="text-muted">Escanea este código con la cámara de tu aplicación autenticadora.</small>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <script>
        new QRCode(document.getElementById("qrCode"), {
            text: "@Html.Raw(Model.AuthenticatorUri)",
            width: 180,
            height: 180
        });
    </script>
}
