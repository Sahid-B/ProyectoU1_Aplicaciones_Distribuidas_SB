@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Datos Personales";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="bg-primary bg-opacity-10 text-primary p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="bi bi-hdd-network fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Datos Personales y Privacidad</h3>
                <p class="text-muted small mb-0">Gestión de la información personal de tu cuenta en Supermarket Rubik.</p>
            </div>
        </div>
        <hr class="my-4 text-muted opacity-25" />

        <div class="alert alert-info border-0 shadow-sm rounded-3 d-flex align-items-center gap-3 mb-4">
            <i class="bi bi-shield-check fs-2 text-info"></i>
            <div>
                <strong>Privacidad de Datos Garantizada:</strong>
                <p class="mb-0 small">Tu cuenta contiene información personal de registro y actividad. Puedes descargar una copia completa en formato JSON o eliminar tu cuenta de forma permanente.</p>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 border border-light shadow-sm rounded-4 p-4 text-center">
                    <div class="mb-3">
                        <i class="bi bi-download fs-1 text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Descargar Mis Datos</h5>
                    <p class="text-muted small mb-4">Obtén un archivo descargable en formato de texto plano con toda tu información registrada en nuestro sistema.</p>
                    <form id="download-user-data" asp-page="DownloadPersonalData" method="post" class="mt-auto">
                        <button class="btn btn-primary w-100 rounded-pill py-2 fw-semibold" type="submit">
                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Descargar Datos
                        </button>
                    </form>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card h-100 border border-danger border-opacity-25 shadow-sm rounded-4 p-4 text-center bg-danger bg-opacity-10">
                    <div class="mb-3">
                        <i class="bi bi-exclamation-triangle fs-1 text-danger"></i>
                    </div>
                    <h5 class="fw-bold text-danger">Eliminar Mi Cuenta</h5>
                    <p class="text-danger opacity-75 small mb-4">Esta acción eliminará permanentemente tu cuenta y todos tus datos sin posibilidad de recuperación.</p>
                    <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger w-100 rounded-pill py-2 fw-semibold mt-auto">
                        <i class="bi bi-trash3 me-1"></i> Eliminar Cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
