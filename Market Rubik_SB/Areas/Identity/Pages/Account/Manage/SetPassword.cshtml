@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Establecer Contraseña";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="row">
    <div class="col-md-10 col-lg-8">
        <div class="d-flex align-items-center gap-3 mb-3 text-primary">
            <div class="bg-primary bg-opacity-10 p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                <i class="bi bi-key-fill fs-4"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0 text-dark">Establecer Contraseña Local</h3>
                <p class="text-muted small mb-0">Crea una contraseña para poder iniciar sesión sin Google.</p>
            </div>
        </div>
        <hr class="my-4 text-muted opacity-25" />

        <partial name="_StatusMessage" for="StatusMessage" />

        <div class="alert alert-info d-flex align-items-center gap-2 rounded-3 mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-5 flex-shrink-0"></i>
            <div>
                Actualmente no tienes contraseña local. Estás accediendo con <strong>Google</strong>.
                Si estableces una contraseña, podrás iniciar sesión con tu correo y contraseña también.
            </div>
        </div>

        <form id="set-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="Input.NewPassword"
                       class="form-control border-primary border-opacity-25"
                       autocomplete="new-password"
                       placeholder="Nueva contraseña" />
                <label asp-for="Input.NewPassword" class="form-label">Nueva Contraseña</label>
                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword"
                       class="form-control border-primary border-opacity-25"
                       autocomplete="new-password"
                       placeholder="Confirmar contraseña" />
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirmar Contraseña</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="bi bi-shield-check me-1"></i> Establecer Contraseña
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
