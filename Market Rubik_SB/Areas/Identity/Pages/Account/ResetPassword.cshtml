@page
@model MiniMarketApp.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Restablecer Contraseña - Supermarket Rubik";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden auth-card">
            <div class="card-header text-white text-center py-4 px-4" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="security-badge-wrapper mb-2">
                    <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm p-3" style="width: 64px; height: 64px;">
                        <i class="bi bi-shield-lock-fill text-primary fs-2"></i>
                    </div>
                </div>
                <h3 class="fw-bold mb-1">Restablecer Contraseña</h3>
                <p class="mb-0 text-white-50 fs-6">Ingresa tu nueva contraseña</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <form method="post">
                    <input asp-for="Input.Code" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 border-0 shadow-sm" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control rounded-3" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                        <label asp-for="Input.Email" class="text-muted"><i class="bi bi-envelope-fill me-1 text-primary"></i> Correo Electrónico</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Nueva Contraseña" />
                        <label asp-for="Input.Password" class="text-muted"><i class="bi bi-lock-fill me-1 text-primary"></i> Nueva Contraseña</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control rounded-3" autocomplete="new-password" aria-required="true" placeholder="Confirmar Nueva Contraseña" />
                        <label asp-for="Input.ConfirmPassword" class="text-muted"><i class="bi bi-lock-fill me-1 text-primary"></i> Confirmar Nueva Contraseña</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-primary bg-gradient btn-lg rounded-3 fw-bold shadow-sm py-3 mb-3 border-0 d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-check-circle-fill"></i> Guardar Nueva Contraseña
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
