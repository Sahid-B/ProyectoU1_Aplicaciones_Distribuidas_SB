@page
@{
    ViewData["Title"] = "Confirmación de Recuperación - Supermarket Rubik";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4 overflow-hidden auth-card text-center">
            <div class="card-header text-white py-4 px-4" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
                <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle shadow-sm p-3 mb-2" style="width: 64px; height: 64px;">
                    <i class="bi bi-check-lg text-success fs-1"></i>
                </div>
                <h3 class="fw-bold mb-1">Solicitud Enviada</h3>
                <p class="mb-0 text-white-50 fs-6">Recuperación de Contraseña</p>
            </div>

            <div class="card-body p-4 p-md-5">
                <p class="text-muted mb-4">
                    Por favor revisa la bandeja de entrada de tu correo electrónico para seguir las instrucciones de restablecimiento de contraseña.
                </p>

                <a asp-page="./Login" class="btn btn-primary bg-gradient btn-lg rounded-3 fw-bold shadow-sm px-4 py-2 border-0">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Ir al Inicio de Sesión
                </a>
            </div>
        </div>
    </div>
</div>
