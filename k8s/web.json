{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "web",
        "namespace": "market-rubik"
      },
      "spec": {
        "replicas": 3,
        "strategy": {
          "type": "RollingUpdate"
        },
        "selector": {
          "matchLabels": {
            "app": "web"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "web"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "web",
                "image": "market-rubik-web:parte1",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "market-settings"
                    }
                  }
                ],
                "env": [
                  {
                    "name": "Database__SkipInitialization",
                    "value": "true"
                  },
                  {
                    "name": "AIService__Url",
                    "value": "http://ai:5000"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8080
                  }
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8080
                  }
                }
              }
            ],
            "volumes": []
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "web",
        "namespace": "market-rubik"
      },
      "spec": {
        "selector": {
          "app": "web"
        },
        "ports": [
          {
            "port": 8080,
            "targetPort": 8080
          }
        ]
      }
    }
  ]
}
