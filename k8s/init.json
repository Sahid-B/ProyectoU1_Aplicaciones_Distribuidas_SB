{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "batch/v1",
      "kind": "Job",
      "metadata": {
        "name": "market-init",
        "namespace": "market-rubik"
      },
      "spec": {
        "backoffLimit": 4,
        "template": {
          "spec": {
            "restartPolicy": "Never",
            "containers": [
              {
                "name": "initialize",
                "image": "market-rubik-web:parte1",
                "imagePullPolicy": "IfNotPresent",
                "args": [
                  "--initialize"
                ],
                "envFrom": [
                  {
                    "secretRef": {
                      "name": "market-settings"
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
